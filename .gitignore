# =============================================================================
# QleamAI – Root .gitignore
# Covers: Python, Node.js, Terraform, build artifacts, secrets, OS/IDE files
# =============================================================================

# ── Design / Planning docs (local only) ──────────────────────────────────────
AIdeas/

# ── Python ────────────────────────────────────────────────────────────────────
# Virtual environments
.venv/
venv/
env/
ENV/

# Compiled Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg
.eggs/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
*.xml

# mypy / type checkers
.mypy_cache/
.dmypy.json
.pytype/

# ── Node.js / Next.js ─────────────────────────────────────────────────────────
# Dependencies (the main culprit – ~200MB)
node_modules/

# Next.js build output
.next/
out/

# TypeScript incremental build info
*.tsbuildinfo

# ── Backend Lambda staging ────────────────────────────────────────────────────
# Lambda pip-install staging dir (created by build_lambda.bat/sh)
backend/package/

# ── Terraform ────────────────────────────────────────────────────────────────
# Working directories and state (sensitive!)
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfstate.backup
terraform.tfvars
*.auto.tfvars
crash.log
crash.*.log
*.tfplan
tfplan.binary
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lambda ZIPs (auto-generated by build scripts / Terraform)
lambda_source.zip
lambda_package.zip
infra/lambda_source.zip
infra/lambda_package.zip

# ── Secrets / Environment files ───────────────────────────────────────────────
# Never commit real credentials
.env
.env.local
.env.*.local
*.env

# Keep the examples (they contain no real values)
!.env.example
!.env.local.example
!backend/.env.example
!frontend/.env.local.example

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Planning / Design documents ──────────────────────────────────────────────
# Word docs used for ideation/design; not part of the codebase
AIdeas/

# ── Planning / Design documents ───────────────────────────────────────────────
AIdeas/

# ── Planning / idea documents ─────────────────────────────────────────────────
AIdeas/

# ── Misc build / temp ─────────────────────────────────────────────────────────
.cache/
tmp/
temp/
